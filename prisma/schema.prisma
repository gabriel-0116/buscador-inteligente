generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model Supplier {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  catalogs  Catalog[]
}

model Catalog {
  id               String        @id @default(cuid())
  supplierId       String
  fileName         String
  status           CatalogStatus @default(PROCESSING)
  pageCount        Int?
  // Total PageProductMention rows produced by the page analyzer.
  pageProductCount Int?
  pdfStoragePath   String?
  error            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  supplier        Supplier             @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  pages           CatalogPage[]
  analyses        PageAnalysis[]
  productMentions PageProductMention[]

  @@index([supplierId])
  @@index([status])
}

model CatalogPage {
  id         String @id @default(cuid())
  catalogId  String
  pageNumber Int
  imageUrl   String
  width      Int
  height     Int
  // Full-page DINOv2 (768) embedding — supports the hybrid visual signal in
  // page_mentions search. Never the primary signal: visual-only matches are
  // capped at "low confidence" by the reranker.
  visualEmbedding Unsupported("vector(768)")?
  createdAt       DateTime                    @default(now())

  catalog         Catalog              @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  analyses        PageAnalysis[]
  productMentions PageProductMention[]

  @@index([catalogId])
  @@unique([catalogId, pageNumber])
}

model PageAnalysis {
  id            String   @id @default(cuid())
  catalogId     String
  pageId        String
  pageNumber    Int
  provider      String?
  model         String?
  rawJson       Json
  productsCount Int
  error         String?
  createdAt     DateTime @default(now())

  catalog Catalog     @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  page    CatalogPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([catalogId])
  @@index([pageId])
}

// Page-level search unit. Each row is one product detected by the multimodal
// analyzer on a catalog page. There is no crop: the page is the visual
// result, the mention is the unit of intelligence. The embedding is
// *textual/semantic* over the consolidated `searchText` and is what the
// hybrid search ranks against (alongside the visual DINOv2 embedding on
// CatalogPage).
model PageProductMention {
  id        String @id @default(cuid())
  catalogId String
  pageId    String

  pageNumber Int
  // Visual order of the product on the page (1-based, left→right, top→bottom).
  // Set by process-catalog from the analyzer's response order. NULL on rows
  // written before the column existed; Postgres sorts NULLs last in ASC.
  displayOrder Int?

  namePt        String
  originalName  String?
  descriptionPt String?
  category      String?
  functionGroup String?

  // Strong textual signals — extracted by the analyzer so they outrank the
  // pt-BR translation. Same modelCode → same product, regardless of how the
  // catalog spells it.
  brand      String?
  modelCodes String[] @default([])
  aliases    String[] @default([])

  colors              String[]
  visualAttributes    String[]
  technicalAttributes String[]
  notConfuseWith      String[]
  commercialUse       String?

  isKit       Boolean  @default(false)
  kitContains String[]

  confidence     Float?
  evidenceText   String?
  // "vision" | "pdf_text" | "both" | "manual"
  evidenceSource String?

  searchText String
  embedding  Unsupported("vector(768)")?

  rawJson   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  catalog Catalog     @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  page    CatalogPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([catalogId])
  @@index([pageId])
  @@index([pageId, displayOrder])
  @@index([functionGroup])
  @@index([category])
  @@index([pageNumber])
  @@index([brand])
}

enum CatalogStatus {
  PROCESSING
  READY
  FAILED
}
