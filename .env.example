DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."
SUPABASE_URL="https://xxx.supabase.co"
SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ── Multimodal provider (shared by page + query analyzers) ──────────────────
# Required to detect products on each page and to interpret the user's
# search image. Provider must be 'openai' or 'anthropic'.
#
# For a LOCAL, ZERO-COST setup with LM Studio / Ollama / llama-server:
#   1. Keep VISION_DETECTOR_PROVIDER="openai" (the request shape is the
#      same — only the destination changes).
#   2. Set VISION_DETECTOR_BASE_URL to your local runtime, e.g.
#        LM Studio: http://localhost:1234
#        Ollama:    http://localhost:11434
#   3. VISION_DETECTOR_API_KEY can be any non-empty string ("local").
#   4. Set PAGE_ANALYZER_MODEL / QUERY_ANALYZER_MODEL to the local model
#      name as it shows up in your runtime (e.g. "qwen2.5-vl-7b-instruct").
#   5. Bump VISION_DETECTOR_TIMEOUT_MS — local runs are 10-60s/page.
VISION_DETECTOR_PROVIDER="openai"
VISION_DETECTOR_API_KEY=""
# Optional. Leave empty for hosted OpenAI; set to localhost URL for a
# local OpenAI-API-compatible runtime.
VISION_DETECTOR_BASE_URL=""
# Per-request HTTP timeout in ms (default 120000 = 2 min). For local LLMs
# 300000-600000 is a sane range.
VISION_DETECTOR_TIMEOUT_MS="120000"

# Cost knobs for the multimodal calls. The page is downscaled to a cheap
# JPEG before being sent to the model.
VISION_DETECTOR_MAX_IMAGE_WIDTH="1280"
VISION_DETECTOR_JPEG_QUALITY="75"

# Structural detector (PyMuPDF). The page analyzer is fed the PDF's text
# blocks as evidence to help extract codes/names; failure here just means
# the analyzer runs without that hint. PYTHON_BIN selects the interpreter
# Node spawns; it must `import fitz` (pip install PyMuPDF).
PYTHON_BIN="python3"

# ── Page analyzer ───────────────────────────────────────────────────────────
# Multimodal model used to enumerate products on a rendered page. Falls
# back to VISION_DETECTOR_MODEL_CHEAP so one env can configure both
# analyzers at once.
VISION_DETECTOR_MODEL_CHEAP="gpt-5.4-mini"
PAGE_ANALYZER_MODEL=""                       # overrides VISION_DETECTOR_MODEL_CHEAP
PAGE_ANALYZER_MAX_OUTPUT_TOKENS="2400"

# ── Query image analyzer ────────────────────────────────────────────────────
# Transforms Rafael's search image into the structured ImageQueryProfile.
QUERY_ANALYZER_MODEL=""                      # falls back to PAGE_ANALYZER_MODEL → VISION_DETECTOR_MODEL_CHEAP
QUERY_ANALYZER_MAX_OUTPUT_TOKENS="1200"
QUERY_ANALYZER_MAX_IMAGE_WIDTH="1024"

# ── Text/semantic embeddings ────────────────────────────────────────────────
# Indexed into PageProductMention.embedding. Default target is the local
# LM Studio runtime with nomic-embed-text-v1.5 (768d) — the Prisma column
# is vector(768) to match. To fall back to hosted OpenAI:
#   TEXT_EMBEDDING_BASE_URL=""                       (empty = api.openai.com)
#   TEXT_EMBEDDING_MODEL="text-embedding-3-small"
#   TEXT_EMBEDDING_DIMENSIONS="1536"
# and run the reverse migration on PageProductMention.embedding.
TEXT_EMBEDDING_PROVIDER="openai"
TEXT_EMBEDDING_BASE_URL="http://127.0.0.1:1234"
TEXT_EMBEDDING_MODEL="nomic-embed-text-v1.5"
TEXT_EMBEDDING_DIMENSIONS="768"
# Optional override — falls back to OPENAI_API_KEY then VISION_DETECTOR_API_KEY.
# Can be any placeholder when TEXT_EMBEDDING_BASE_URL points at localhost.
TEXT_EMBEDDING_API_KEY=""

# ── Page dedup ──────────────────────────────────────────────────────────────
# Before calling the paid analyzer on a page, check whether a sibling page
# (same supplier, different READY catalog) is the same: DINOv2 visual cosine
# above DEDUP_VISUAL_THRESHOLD AND PyMuPDF text hash equal. If so, the
# mentions are copied and the analyzer is skipped — this is the main cost
# control for weekly reprints of the same supplier's catalog.
# - first run after this lands: nothing matches (no historical hashes), full
#   cost. From the second run onward, unchanged pages short-circuit.
# - threshold tuning: 0.97 catches most reprints; raise toward 0.99 if you
#   see false dedups (mentions inherited from the wrong page).
# - DEDUP_VISUAL_THRESHOLD_STRICT is used when one side is missing the text
#   hash (PyMuPDF failed or legacy row).
DEDUP_ENABLED="true"
DEDUP_VISUAL_THRESHOLD="0.97"
DEDUP_VISUAL_THRESHOLD_STRICT="0.99"
